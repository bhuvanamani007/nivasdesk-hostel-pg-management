# GEMINI_API_KEY: Required only if AI features are added later (not required for core PG operations).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: HMAC signing secret for cookie-based staff sessions (auto-generated in dev if omitted)
SESSION_SECRET="replace-with-32-byte-random-hex"

# STORAGE_DIR: Private directory for guest ID documents & expense bill attachments (never publicly served)
STORAGE_DIR="./.data/objects"

# DEFAULT_TIMEZONE: Default timezone for Tamil Nadu PG hostel operations
DEFAULT_TIMEZONE="Asia/Kolkata"

# TELEPHONY_PROVIDER: "disabled" | "mock" | "exotel" | "twilio"
TELEPHONY_PROVIDER="mock"
# EXOTEL_SID=""
# EXOTEL_API_KEY=""
# EXOTEL_API_TOKEN=""
# EXOTEL_CALLER_ID=""

# SMS_PROVIDER: "disabled" | "mock" | "msg91" | "twilio"
SMS_PROVIDER="mock"
# MSG91_AUTH_KEY=""
# MSG91_TEMPLATE_ID=""
# MSG91_SENDER_ID=""

# WHATSAPP_PROVIDER: "disabled" | "mock" | "meta_cloud" | "gupshup"
WHATSAPP_PROVIDER="mock"
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_ID=""
